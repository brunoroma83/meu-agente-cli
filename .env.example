# =====================================================================
# VARIÁVEIS DE AMBIENTE - MEU AGENTE CLI
# =====================================================================

# Token do Bot do Telegram (Obtenha com o @BotFather no Telegram)
TELEGRAM_BOT_TOKEN=seu_telegram_bot_token_aqui

# IDs numéricos de usuários do Telegram autorizados a interagir com o agente (separados por vírgula)
# Obtenha o seu ID enviando uma mensagem para @userinfobot
TELEGRAM_AUTHORIZED_USER_IDS=12345678,98765432

# URL base do servidor LM Studio
# - Em produção no servidor: http://192.168.1.15:1234
# - Em desenvolvimento local (Windows WSL): http://host.docker.internal:1234
LM_STUDIO_URL=http://192.168.1.15:1234

# Provedor de Backup LLM: Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=seu_cloudflare_account_id
CLOUDFLARE_API_TOKEN=seu_cloudflare_api_token

# Banco de Dados PostgreSQL Centralizado
# Em Desenvolvimento: DB_HOST=postgres_dev | FINANCEIRO_DB_PASSWORD=financeiro_dev_password
# Em Produção: DB_HOST=postgres | FINANCEIRO_DB_PASSWORD=<senha-do-banco-de-dados/.env>
DB_HOST=postgres
DB_PORT=5432
FINANCEIRO_DB_NAME=financeiro_db
FINANCEIRO_DB_USER=financeiro_user
FINANCEIRO_DB_PASSWORD=sua_senha_aqui
